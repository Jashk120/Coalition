# Copy to ~/pool/.env on the VPS and fill the 4 required values.
# Canonical terms URL must be https: it becomes the on-chain resourceURI.

# --- required: fill these ---
# No domain? Use nip.io: PUBLIC_BASE_URL=https://<vps-ip>.nip.io
PUBLIC_BASE_URL=https://pool.example.com
PROVIDER_ADDRESS=0x0000000000000000000000000000000000000000
# Leave EMPTY for first boot (listener stays off). Zero address is NOT empty:
# it makes the listener poll 0x0. Fill after deploying the pool, then restart.
POOL_ADDRESS=
# Operator app key for POST /allocate (sent as X-App-Key header).
# Generate: openssl rand -hex 32. Minimum 16 chars.
# For a first dev boot you may use ALLOW_NO_APP_AUTH=1 instead — never in prod.
APP_API_KEY=
ALLOW_NO_APP_AUTH=1
# IMAGE is read by compose.yml (defaults to the example below when unset)
IMAGE=ghcr.io/jashk120/coalition-orchestrator:latest
DOMAIN=pool.example.com

# --- safe defaults: leave as-is for first deploy ---
PORT=8080
RPC_URL=https://rpc.testnet.arc.network
REQUIRE_DOCKER=1
TRUST_PROXY=0
DOCKER_NETWORK_MODE=none
TARGET_USDC=10.00
MAX_AGENTS=5
WINDOW_HOURS=72
CPU_UNITS=1
MEM_MB=4096
RESOURCE_NAME=Coalition Pool #1
POLL_INTERVAL=5s
CONFIRMATIONS=1
REAPER_INTERVAL=10s
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
