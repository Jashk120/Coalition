# Public (safe to expose, NEXT_PUBLIC_* only).
NEXT_PUBLIC_POOL_ADDRESS=0x8b9f38c7B005Dd67203e27240F45335a9e64F692
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8080

# Server-only (never NEXT_PUBLIC_): RPC + subgraph secrets stay in route handlers.
ARC_RPC_URL=https://rpc.testnet.arc.io
SEPOLIA_RPC_URL=
SUBGRAPH_ENDPOINT=
SUBGRAPH_API_KEY=
# Optional: first Arc block with IdentityRegistry code (log-scan floor).
# Defaults to 29241340; override only if the registry redeploys.
# IDENTITY_REGISTRY_FROM_BLOCK=29241340
# Optional: pool provider wallet used as a reputation reviewer (falls back to seed wallets).
PROVIDER_ADDRESS=
# First Arc block carrying pool code (activity log-scan floor). Set to the
# deployed pool's birth block so scans stay one chunk; defaults to the v1 pool.
POOL_DEPLOY_BLOCK=61221987
# Server-only (never NEXT_PUBLIC_): Orchestrator base URL + app key for
# POST /api/pools/free → POST /free-pool relay and POST /api/resale/buy →
# POST /commit-mint. The key never reaches the browser.
# ORCHESTRATOR_URL=http://localhost:8080
# ORCHESTRATOR_APP_KEY=
# Server-only (never NEXT_PUBLIC_): Circle Developer-Controlled Wallets for POST /api/agents/fund.
# Create an API key at console.circle.com/api-keys, register the entity secret once,
# create ARC-TESTNET wallets, fund via https://faucet.circle.com.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_IDS=
# Held-out resale buyer (agent-5): mint via `node create-buyer-wallet.mjs`,
# fund the printed address with ARC-TESTNET USDC at https://faucet.circle.com
# (buys check on-chain balance fail-fast; settlement is one atomic Multicall3
# aggregate, so no Gateway deposit is needed). NEVER append to CIRCLE_WALLET_IDS.
# CIRCLE_BUYER_WALLET_ID=
# App Kit treasury (POST /api/agents/treasury): a Circle DCW on ARC-TESTNET
# funded with USDC, used by `kit.send` to fund wallets. Server-only.
# CIRCLE_TREASURY_WALLET_ID=
# Optional per-recipient funding amount in decimal USDC (default 2.50).
# CIRCLE_TREASURY_FUND_USDC=2.50
# Circle Contracts deployer wallet for `node deploy-pool-circle.mjs` (SCP).
# CIRCLE_DEPLOYER_WALLET_ID=
# Wallet id whose address is the pool provider (startRound is provider-only).
# Required for POST /api/agents/rotate ("Free pool"); must be one of CIRCLE_WALLET_IDS.
CIRCLE_PROVIDER_WALLET_ID=
# Optional: JSON-lines debug file every route-handler log is appended to
# (in addition to stdout/stderr). Defaults to logs/debug.log under app/.
# DEBUG_LOG_FILE=logs/debug.log
